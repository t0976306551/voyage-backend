# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=voyagestack

# NextAuth (共用 secret，用於驗證前端傳來的 JWT)
NEXTAUTH_SECRET=super-secret-key-for-nextauth-min-32-chars

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Trust proxy — 讓速率限制能認出真實使用者 IP（上線在代理後面時才需要）
# 怎麼填：
#   本機開發 / 直連對外          → 不用設（維持註解狀態）
#   一般雲端平台（Render/Fly/    → 1
#     Zeabur/單一 nginx 等）
#   Cloudflare 再接你的伺服器    → 2
# ⚠️ 不要填 true（會讓人偽造 IP 繞過速率限制）；不確定就填 1。
# TRUST_PROXY=1
